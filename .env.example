# Copia questo file in .env.local e inserisci i valori del progetto Supabase
# (Supabase → Project Settings → API Keys / Data API).
# .env.local non viene mai caricato su GitHub.

# Indirizzo del progetto, es. https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Chiave pubblicabile (inizia con sb_publishable_…). NON usare la chiave segreta.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
